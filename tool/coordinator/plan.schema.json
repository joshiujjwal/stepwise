{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coordinator.app/schemas/plan.schema.json",
  "title": "PlannerResponse",
  "description": "Response from the Coordinator: either a clarifying turn or a proposed plan of micro-tasks. Strictly human-executed: tasks are actions the USER performs.",
  "oneOf": [
    { "$ref": "#/$defs/clarify" },
    { "$ref": "#/$defs/plan" }
  ],
  "$defs": {
    "clarify": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "questions"],
      "properties": {
        "action": { "const": "ask_clarifying" },
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "type": "string", "minLength": 5, "maxLength": 160 }
        }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "idea_type", "micro_tasks"],
      "properties": {
        "action": { "const": "propose_plan" },
        "idea_type": { "enum": ["tax", "trip", "errand", "admin", "project", "other"] },
        "summary": { "type": "string", "maxLength": 200 },
        "micro_tasks": {
          "type": "array",
          "minItems": 2,
          "maxItems": 15,
          "items": { "$ref": "#/$defs/micro_task" }
        }
      }
    },
    "micro_task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "est_minutes", "acceptance_criteria", "order_index"],
      "properties": {
        "title": { "type": "string", "minLength": 6, "maxLength": 80 },
        "description": { "type": "string", "minLength": 1, "maxLength": 400 },
        "est_minutes": { "type": "integer", "minimum": 5, "maximum": 60, "multipleOf": 5 },
        "order_index": { "type": "integer", "minimum": 1 },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/criterion" }
        }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "evidence_type"],
      "properties": {
        "text": { "type": "string", "minLength": 4, "maxLength": 160 },
        "evidence_type": { "enum": ["checkbox", "note", "url", "file"] }
      }
    }
  }
}
